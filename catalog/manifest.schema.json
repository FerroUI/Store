{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Ferro App Manifest v1",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "name",
    "summary",
    "description",
    "category",
    "author",
    "icon",
    "launch"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "maxLength": 64
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 180
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 6000
    },
    "category": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40
    },
    "author": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "icon": {
      "type": "string",
      "format": "uri-reference"
    },
    "accent": {
      "type": "string",
      "pattern": "^#[0-9a-fA-F]{6}$"
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40
    },
    "source": {
      "type": "string",
      "format": "uri-reference"
    },
    "tags": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 40
      }
    },
    "launch": {
      "type": "object",
      "required": [
        "url"
      ],
      "properties": {
        "url": {
          "type": "string",
          "format": "uri-reference"
        },
        "mode": {
          "enum": [
            "embed",
            "tab"
          ],
          "default": "tab"
        }
      }
    },
    "screenshots": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "object",
        "required": [
          "url",
          "alt"
        ],
        "properties": {
          "url": {
            "type": "string",
            "format": "uri-reference"
          },
          "alt": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          }
        }
      }
    },
    "videos": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "object",
        "required": [
          "url",
          "alt"
        ],
        "properties": {
          "url": {
            "type": "string",
            "format": "uri-reference"
          },
          "alt": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          },
          "type": {
            "enum": [
              "video/mp4",
              "video/webm"
            ]
          }
        }
      }
    }
  }
}
